<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zad10_3.MainPage"
             Title="Zdający nr 1">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Slider
                x:Name="SzaroscSlider"
                Minimum="0"
                Maximum="255"
                Value="255"
                MaximumTrackColor="MediumPurple"/>

            <Label
                x:Name="LiczbaLabel"
                Text="{Binding Source={x:Reference SzaroscSlider}, Path=Value, StringFormat='Poziom: {0:F0}'}"/>

            <Button
                x:Name="ZastosujButton"
                Text="Zastosuj jako szarość"
                Clicked="ZastosujButton_Clicked"/> 

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
