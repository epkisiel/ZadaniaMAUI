<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zad7_3.MainPage"
             Title="zdający nr 1">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Slider
                x:Name="Rslider"
                Minimum="0"
                Maximum="255"
                ValueChanged="slider_ValueChanged"
                MinimumTrackColor="red"
                ThumbColor="red"
                Value="255"/>


            <Slider
                x:Name="Gslider"
                Minimum="0"
                Maximum="255"
                ValueChanged="slider_ValueChanged"
                MinimumTrackColor="green"
                ThumbColor="green"
                Value="255"/>

            <Slider
                x:Name="Bslider"
                Minimum="0"
                Maximum="255"
                ValueChanged="slider_ValueChanged"
                MinimumTrackColor="blue"
                ThumbColor="blue"
                Value="255"/>

            <Label
                x:Name="AktualnyLabel"
                Text="Aktualny kolor: #FFFFFF"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
