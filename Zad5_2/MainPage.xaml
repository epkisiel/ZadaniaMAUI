<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zad5_2.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Wybierz ocenę"
                FontAttributes="Bold"
                FontSize="26"
                TextColor="#002352"/>

            <Label
                x:Name="OcenaLabel"
                Text="Ocena: 3"/>

            <Slider
                x:Name="OcenaSlider"
                Minimum="1"
                Maximum="6"
                Value="3"
                ValueChanged="OcenaSlider_ValueChanged"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
