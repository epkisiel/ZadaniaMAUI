<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zad6_2.MainPage"
             Title="zdający nr 1">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Slider
                x:Name="WartoscSlider"
                Minimum="0"
                Maximum="255"
                Value="0"
                ValueChanged="WartoscSlider_ValueChanged"/>

            <Label
                x:Name="LiczbaLabel"
                Text="Wartość: 0"/>

            <Label
                x:Name="SlowoLabel"
                Text="Mało"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
