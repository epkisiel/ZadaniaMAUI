<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zad9_2.MainPage"
             Title="Zdający nr 1">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Entry
                x:Name="ProduktEntry"/>

            <Button
                x:Name="DodajButton"
                Text="Dodaj do listy zakupów"
                Clicked="DodajButton_Clicked"/>

            <CollectionView
                x:Name="ListaZakupow">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label
                            Text="{Binding .}"
                            FontSize="20"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
