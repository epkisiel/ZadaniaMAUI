<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zad3_2.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                x:Name="NazwaLabel"
                Text="Panel kontaktowy"/>

            <Entry
                x:Name="EmailEntry"
                Placeholder="Wpisz email"/>

            <Entry
                x:Name="TelefonEntry"
                  Placeholder="Podaj numer telefonu"/>

            <HorizontalStackLayout
                Spacing="20">
                <Button
                    x:Name="WyslijButton"
                    Text="Wyślij"/>

                <Button
                    x:Name="WyczyscButton"
                    Text="Wyczyść"
                    Clicked="WyczyscButton_Clicked"/>

            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
