<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zad4_2.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Entry
                x:Name="ImieEntry"
                Placeholder="Imię i nazwisko"/>

            <HorizontalStackLayout>
                <CheckBox
                    x:Name="WiedzaCheckBox"/>
                <Label
                    Text="Posiadam podstawową wiedzę"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <Switch
                    x:Name="CertyfikatSwitch"/>
                <Label
                    Text="Chcęo trzymać certyfikat"/>
            </HorizontalStackLayout>

            <Button
                x:Name="ZapiszSieButton"
                Text="Zapisz się"
                Clicked="ZapiszSieButton_Clicked"/>

            <Label
                x:Name="PodsumowanieLabel"
                Text=""/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
