             x:Class="Zad8_2.MainPage"
             Title="zdający nr 1">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Entry
                x:Name="WiekEntry"
                Placeholder="Podaj swój wiek"/>

            <Button
                Text="Pokaż mój wiek"
