<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zad8_3.MainPage"
             Title="zdający nr 1">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Entry
                x:Name="SzerokoscEntry"
                Placeholder="Szerokość"/>

            <Entry
                x:Name="WysokoscEntry"
                Placeholder="Wysokość"/>

            <Button
                x:Name="ObliczButton"
                Text="Oblicz"
                Clicked="ObliczButton_Clicked"/>

            <Button
                x:Name="WyczyscButton"
                Text="Wyczyść"
                Clicked="WyczyscButton_Clicked"/>

            <Label
                x:Name="WynikLabel"
                IsVisible="False"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
